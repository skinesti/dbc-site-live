#!/bin/sh
#
# pre-commit — make sure the Eleventy build still compiles before every commit.
#
# Runs `npm run build:check` (eleventy --dryrun): it renders every template in
# memory without writing _site/, so a broken layout, a bad Nunjucks tag, or a
# config error stops the commit instead of reaching Netlify.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass in an emergency:   git commit --no-verify

set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if [ ! -d node_modules ]; then
	echo "pre-commit: node_modules/ is missing." >&2
	echo "Run 'npm install' first, or bypass once with: git commit --no-verify" >&2
	exit 1
fi

echo "pre-commit: checking the Eleventy build..."
npm run build:check

exit 0
