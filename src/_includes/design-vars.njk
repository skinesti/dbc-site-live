{#-
  design-vars.njk — turns src/_data/design.json into a Google Fonts <link>
  and a :root override block. Included from base.njk's <head>, AFTER style.css,
  so these values win over the defaults baked into style.css.

  Headings are always Playfair Display (locked).

  Eyebrow font also carries the per-font rendering rules for the "Eyebrow"
  lead-in style — each option emits a COMPLETE `.eyebrow` property set (not a
  delta) so switching between fonts is deterministic:
    - Marck Script          script face, natural case, no tracking (weight 700)
    - Jost                  the site's original label treatment: UPPERCASE +
                            .18em tracking (the one exception to "no uppercase")
    - Playfair Display Italic  serif italic, natural case, no tracking —
                            same visual treatment as the Editorial lead-in
  `color:var(--accent)` and `font-family:var(--script)` come from style.css's
  base `.eyebrow`; the rules below never touch colour.
-#}
{%- set eyebrowFonts = {
  "Marck Script": {
    family: "Marck+Script",
    stack: '"Marck Script", "Segoe Script", "Brush Script MT", cursive',
    rules: "font-size:calc(1.15rem + 2pt);font-weight:700;font-style:normal;text-transform:none;letter-spacing:normal;line-height:1.6;margin:0 0 1em;"
  },
  "Jost": {
    family: "Jost:wght@400;500;600",
    stack: '"Jost", "Helvetica Neue", Arial, sans-serif',
    rules: "font-size:.84rem;font-weight:500;font-style:normal;text-transform:uppercase;letter-spacing:.18em;line-height:1.6;margin:0 0 1em;"
  },
  "Playfair Display Italic": {
    family: "",
    stack: '"Playfair Display", Georgia, serif',
    rules: "font-size:1.2rem;font-weight:400;font-style:italic;text-transform:none;letter-spacing:normal;line-height:1.3;margin:0 0 .5em;"
  }
} -%}
{%- set bodyFonts = {
  "Work Sans":    { family: "Work+Sans:wght@300;400;500;600",   stack: '"Work Sans", "Helvetica Neue", Arial, sans-serif' },
  "Nunito Sans":  { family: "Nunito+Sans:wght@300;400;600;700", stack: '"Nunito Sans", "Helvetica Neue", Arial, sans-serif' },
  "Archivo":      { family: "Archivo:wght@300;400;500;600",     stack: '"Archivo", "Helvetica Neue", Arial, sans-serif' }
} -%}
{%- set textSizes = { "Small": "16px", "Medium": "17px", "Large": "19px" } -%}
{%- set eb = eyebrowFonts[design.eyebrow_font] or eyebrowFonts["Marck Script"] -%}
{%- set bf = bodyFonts[design.body_font] or bodyFonts["Work Sans"] -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,500;1,600{% if eb.family %}&family={{ eb.family }}{% endif %}&family={{ bf.family }}&display=swap" rel="stylesheet">
<style>
:root{
  --script:{{ eb.stack | safe }};
  --sans:{{ bf.stack | safe }};
  --font-base:{{ textSizes[design.text_size] or "17px" }};
  --accent:{{ design.accent_color or "#C2876F" }};
  --radius:{{ design.button_radius or "6px" }};
}
.eyebrow { {{ eb.rules | safe }} }
</style>
